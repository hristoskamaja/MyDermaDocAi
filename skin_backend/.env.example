# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=change-me-to-a-random-secret-string
DEBUG=True

# Google Gemini API key - used only to generate care recommendation text
# after the local AI model has already predicted a condition.
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Database - set DB_ENGINE=postgres to use PostgreSQL, or leave unset
# (or DB_ENGINE=sqlite) to fall back to a local SQLite file.
DB_ENGINE=postgres
DB_NAME=skinscan
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
