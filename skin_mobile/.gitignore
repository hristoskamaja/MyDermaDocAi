# VS Code
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android - keep android/ tracked (it holds real customizations like the
# app label, permissions, icons), but exclude its build caches and any
# machine-specific local paths.
/android/local.properties
/android/.gradle/
/android/.kotlin/
/android/app/debug
/android/app/profile
/android/app/release
/android/**/build/

# iOS - keep ios/ tracked, exclude generated/build-only content.
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/.symlinks/
/ios/Runner.xcworkspace/xcuserdata/
/ios/Runner.xcodeproj/xcuserdata/
/ios/DerivedData/
*.xcuserstate

# Env files
.env
